@model IEnumerable<SDP.Models.customer>

@{
    ViewData["Title"] = "Customer List";
}
<div style="margin-top:120px;"></div>
<h2>Customer List</h2>


<form asp-action="CustomerList" asp-controller="Customer" method="get">
    <div style="margin-bottom:20px;">
        <input type="text"
               id="search"
               name="search"
               placeholder="Search by Name or Email"
               style="width:300px;height:40px;padding:8px;border:1px solid #ccc;border-radius:5px;" />

        <button type="submit" class="btn btn-primary">
            Search
        </button>
    </div>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Customer ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Contact</th>
            <th>Address</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.customerId</td>
            <td>@item.Name</td>
            <td>@item.email</td>
            <td>@item.contact</td>
            <td>@item.address</td>
            <td>
                <a asp-action="ViewCustomer" asp-route-id="@item.customerId" class="btn btn-info btn-sm">View</a>

                <a asp-action="EditCustomer" asp-route-id="@item.customerId" class="btn btn-warning btn-sm">Edit</a>

                <a asp-action="DeleteCustomer"
                   asp-route-id="@item.customerId"
                   class="btn btn-danger btn-sm"
                   onclick="return confirm('Are you sure you want to delete this customer?');">
                    Delete
                </a>
            </td>
        </tr>
    }
    </tbody>
</table>