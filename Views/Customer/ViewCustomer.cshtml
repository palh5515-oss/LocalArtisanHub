@model SDP.Models.customer

@{
    ViewData["Title"] = "View Customer";
}

<h2>Customer Details</h2>

<table class="table table-bordered">
    <tr>
        <th>Customer ID</th>
        <td>@Model.customerId</td>
    </tr>

    <tr>
        <th>Name</th>
        <td>@Model.Name</td>
    </tr>

    <tr>
        <th>Email</th>
        <td>@Model.email</td>
    </tr>

    <tr>
        <th>Contact</th>
        <td>@Model.contact</td>
    </tr>

    <tr>
        <th>Address</th>
        <td>@Model.address</td>
    </tr>
</table>

<a asp-action="CustomerList" class="btn btn-primary">Back</a>